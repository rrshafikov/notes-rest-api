[flake8]
select = E,F,W,Q

max-line-length = 88
extend-ignore = E203,W503,E501
show-source = True
statistics = True

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    */migrations/*,
    src/db.sqlite3

per-file-ignores =
    __init__.py:F401

inline-quotes = double
multiline-quotes = double
docstring-quotes = double
